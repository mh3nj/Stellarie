# Taskfile.yml
#
# Entry point for STELLAREI's build system, following Wails v3's own
# documented structure (https://v3.wails.io/guides/build/customization/,
# https://v3.wails.io/concepts/build-system/). Task
# (https://taskfile.dev) is Wails v3's build runner; a real `wails3`
# environment normally generates this file (and everything it includes
# below) via `wails3 init`.
#
# HONESTY NOTE; read before assuming this works: this sandbox cannot
# run `wails3` at all (confirmed empirically: `wails3` itself needs
# Go >= 1.25, apt's newest package here is 1.24, and Go's automatic
# toolchain-fetch is blocked by this environment's network policy; see
# README's Phase 13 section). This file's `includes:` below point to
# `./build/Taskfile.windows.yml`, `./build/Taskfile.darwin.yml`, and
# `./build/Taskfile.linux.yml`; files that do NOT exist in this
# checkout. Wails v3 normally generates those with the actual,
# version-specific commands for icon generation, .syso embedding, NSIS
# invocation, WebView2 bootstrapping, .app bundling, and so on; dozens
# of small, tool-specific steps this session has no way to write
# correctly without the real generator to check them against. Writing
# them by hand and having them look plausible but not actually work
# would be worse than not having them at all (spec section 83: "Do not
# implement fake functionality... Do not pretend X works"). Run
# `wails3 init` (or a newer-Go environment's equivalent) to generate
# real versions of those three files before `task build`/`task package`
# will do anything.
#
# What IS real and usable as-is: build/config.yml (project metadata)
# and build/appicon.png (STELLAREI's actual mark, at 6001×6001; reused
# from frontend/src/assets/logo-dark.png, not a placeholder), both of
# which the real generated Taskfiles would read once they exist.

version: '3'

includes:
  windows: ./build/Taskfile.windows.yml
  darwin: ./build/Taskfile.darwin.yml
  linux: ./build/Taskfile.linux.yml

vars:
  APP_NAME: "stellarei"
  BIN_DIR: "bin"
  VITE_PORT: '{{.WAILS_VITE_PORT | default 9245}}'

tasks:
  build:
    summary: Builds the application for the current platform
    cmds:
      - task: "{{OS}}:build"

  package:
    summary: Packages a production build for distribution (NSIS installer on Windows, .app on macOS, AppImage/.deb on Linux)
    cmds:
      - task: "{{OS}}:package"

  run:
    summary: Runs a built binary
    cmds:
      - task: "{{OS}}:run"

  dev:
    summary: Runs the application in development mode with hot reload
    cmds:
      - wails3 dev -config ./build/config.yml -port {{.VITE_PORT}}
